<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MobileMorph Agent"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />
    
    <TextView
        android:id="@+id/deviceIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device ID: Loading..."
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/portText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="31415"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginRight="16dp"/>

        <Switch
            android:id="@+id/serverToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="Stealth OFF"
            android:textOn="Stealth ON"
            android:checked="false"/>
    </LinearLayout>
    <!-- New Start Agent Button -->
    <Button
        android:id="@+id/startAgentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Agent"
        android:layout_marginTop="24dp" />
</LinearLayout>
